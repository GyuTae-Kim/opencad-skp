{
  "name": "opencad-skp",
  "version": "0.1.0",
  "private": true,
  "description": "OpenCAD SketchUp 뷰어: SketchUp 6~2026(.skp) 모형을 브라우저에서 읽어 3D로 보는 앱과 해석기",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "dev": "vite --port 4403",
    "build": "tsc --noEmit && vite build && npm run check:seo && npm run check:i18n",
    "preview": "vite preview --port 4403",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:seo": "node tools/check-seo.mjs",
    "test:seo": "node --test tools/seo.test.mjs",
    "update:content-dates": "vite build && node tools/update-content-dates.mjs",
    "check:i18n": "node tools/check-i18n.mjs",
    "test:i18n": "vitest run tests/i18n.test.ts",
    "sweep": "node scripts/sweep/sweep.mjs",
    "sweep:compare": "node scripts/sweep/compare.mjs"
  },
  "dependencies": {
    "earcut": "^3.2.4",
    "opencad-viewer3d": "github:GyuTae-Kim/opencad-viewer3d#v0.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "jsdom": "22.1.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
