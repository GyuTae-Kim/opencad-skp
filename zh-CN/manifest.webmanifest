{
  "name": "OpenCAD SketchUp 查看器",
  "short_name": "SKP查看器",
  "description": "在浏览器中免费打开SketchUp 6–2026版本保存的SKP文件。查看三维模型的标签、材质、组和组件，测量两点距离并导出PNG图片。无需安装或上传文件，模型在本机浏览器中处理。",
  "lang": "zh-CN",
  "dir": "ltr",
  "start_url": "./",
  "scope": "../",
  "display": "standalone",
  "background_color": "#1b2027",
  "theme_color": "#1b2027",
  "icons": [
    {
      "src": "../icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "files": [
        {
          "name": "file",
          "accept": [
            "application/vnd.sketchup.skp",
            "application/octet-stream",
            ".skp"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/vnd.sketchup.skp": [
          ".skp"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  }
}
