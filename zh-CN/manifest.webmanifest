{
  "name": "OpenCAD SketchUp 查看器",
  "short_name": "SKP查看器",
  "description": "这是一个免费的查看器，无需安装即可打开 SketchUp 6~2026 中保存的 SKP 文件。支持标签、材质、组、元件确认、两点距离测量、PNG保存。文件在浏览器中处理，而不上传到服务器。",
  "lang": "zh-CN",
  "dir": "ltr",
  "start_url": "./",
  "scope": "../",
  "display": "standalone",
  "background_color": "#1b2027",
  "theme_color": "#1b2027",
  "icons": [
    {
      "src": "../icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "files": [
        {
          "name": "file",
          "accept": [
            "application/vnd.sketchup.skp",
            "application/octet-stream",
            ".skp"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/vnd.sketchup.skp": [
          ".skp"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  }
}
