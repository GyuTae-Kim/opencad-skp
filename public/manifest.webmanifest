{
  "name": "OpenCAD SketchUp 뷰어",
  "short_name": "SKP 뷰어",
  "description": "SketchUp 6~2026에서 저장한 SKP 파일을 설치 없이 여는 무료 뷰어입니다. 태그·재질·그룹·컴포넌트 확인, 두 점 거리 측정과 PNG 저장을 지원합니다. 파일은 서버에 업로드하지 않고 브라우저에서 처리합니다.",
  "lang": "ko",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1b2027",
  "theme_color": "#1b2027",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "files": [
        {
          "name": "file",
          "accept": [
            "application/vnd.sketchup.skp",
            "application/octet-stream",
            ".skp"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/vnd.sketchup.skp": [
          ".skp"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  }
}
